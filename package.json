{
  "name": "localnotes",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "check:agent-context": "node scripts/check-agent-context.mjs",
    "predev": "node scripts/copy-ort.js",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint .",
    "test": "npm run test:inner",
    "test:file": "npm run test:file:inner --",
    "test:file:inner": "vitest run",
    "test:inner": "npm run check:agent-context && vitest run src",
    "icons": "node scripts/generate-icons.js",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm run version:sync",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "katex": "^0.18.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "adm-zip": "^0.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
